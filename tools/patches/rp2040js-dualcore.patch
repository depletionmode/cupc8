diff --git i/src/peripherals/psm.ts w/src/peripherals/psm.ts
new file mode 100644
index 0000000..2d401c4
--- /dev/null
+++ w/src/peripherals/psm.ts
@@ -0,0 +1,50 @@
+import { BasePeripheral, Peripheral } from './peripheral.js';
+
+const FRCE_ON = 0x0;
+const FRCE_OFF = 0x4;
+const WDSEL = 0x8;
+const DONE = 0xc;
+
+const PROC1 = 1 << 16;
+
+/** Power-on state machine: only what multicore_reset_core1() needs. */
+export class RPPSM extends BasePeripheral implements Peripheral {
+  frceOn = 0;
+  frceOff = 0;
+  wdsel = 0;
+
+  readUint32(offset: number) {
+    switch (offset) {
+      case FRCE_ON:
+        return this.frceOn;
+      case FRCE_OFF:
+        return this.frceOff;
+      case WDSEL:
+        return this.wdsel;
+      case DONE:
+        return 0x1ffff & ~this.frceOff;
+    }
+    return super.readUint32(offset);
+  }
+
+  writeUint32(offset: number, value: number) {
+    switch (offset) {
+      case FRCE_ON:
+        this.frceOn = value & 0x1ffff;
+        return;
+      case FRCE_OFF: {
+        const released = this.frceOff & PROC1 && !(value & PROC1);
+        this.frceOff = value & 0x1ffff;
+        this.rp2040.core1Held = !!(this.frceOff & PROC1);
+        if (released) {
+          this.rp2040.resetCore1();
+        }
+        return;
+      }
+      case WDSEL:
+        this.wdsel = value & 0x1ffff;
+        return;
+    }
+    super.writeUint32(offset, value);
+  }
+}
