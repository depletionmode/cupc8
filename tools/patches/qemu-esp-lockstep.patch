diff --git i/system/cupc8-lockstep.c w/system/cupc8-lockstep.c
new file mode 100644
index 0000000..d43e648
--- /dev/null
+++ w/system/cupc8-lockstep.c
@@ -0,0 +1,416 @@
+/*
+ * CUPC/8 lockstep: the Wi-Fi card's QEMU in step with the CUPC/8
+ * whole-machine emulator (emu/machine in the CUPC/8 repository).
+ *
+ *   -icount shift=N,sleep=off -chardev cupc8,id=lockstep,path=FIFO
+ *
+ * With icount the guest's clock (QEMU_CLOCK_VIRTUAL) is a function of the
+ * instructions executed, and with sleep=off an idle guest's clock jumps to
+ * the next timer; so the guest is deterministic except for its inputs. This
+ * runs the guest only as far as the emulator allows, and gives it the one
+ * input that matters, the card's slot SPI, at defined guest times through a
+ * stand-in for the ESP32-C3's GPSPI2 slave (the "slot" device below). The
+ * chardev is only the way in for the FIFO's path: nothing is attached to it.
+ * The emulator talks over FIFO.in (commands) and FIFO.out (replies),
+ * little-endian, with times in ns of guest time:
+ *
+ *   'G' t:i64            grant: the guest may run until its clock is t
+ *   'S' t:i64            CS_n falls at t: run to t, reply with the preload
+ *   'F' t:i64 n:u16 b[n] CS_n rose at t ending a frame of MOSI bytes b
+ *   'R' now:i64 armed:u8 b[512]   reply to 'S': the MISO bytes the frame
+ *                        shifts out, and whether the guest re-armed since
+ *                        the last frame ended
+ *
+ * The guest never runs past the last command's time, so it is never ahead of
+ * the emulator, and the emulator never waits for the guest: like the real
+ * SPI slave, the device holds the preload the guest armed and shifts it out
+ * whenever the host selects.
+ *
+ * The slot device (at GPSPI2's address, on GPSPI2's interrupt source):
+ *
+ *   0x000-0x1ff  TX: the next preload, written by the guest
+ *   0x200-0x3ff  RX: the last frame's MOSI bytes
+ *   0x400  TXCOMMIT  write n: the preload becomes TX[0..n) then $00s (the
+ *                    real card's arm(): a whole DMA buffer, swapped in at once)
+ *   0x404  RXLEN     the last frame's length (at most 512, as the real DMA)
+ *   0x408  INT       bit 0 a frame ended, bit 1 another ended before bit 0
+ *                    was cleared (its bytes replaced the first's); write 1s
+ *                    to clear; the interrupt is level, while INT != 0
+ *   0x40c  ID        "C8SL" (a stock QEMU reads 0 here)
+ *
+ * User networking (slirp) is the host's, on the host's clock: it can never be
+ * in step. When the guest sends a packet the vCPU stops right after that
+ * instruction and QEMU waits (wall clock) until slirp has given the guest
+ * nothing new for CUPC8_LOCKSTEP_SETTLE_MS (default 20 ms, at most
+ * CUPC8_LOCKSTEP_SETTLE_MAX_MS, 2000): a host that answers within that time
+ * is seen at a defined guest time. Anything later, or unasked, arrives
+ * whenever the main loop sees it.
+ */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/main-loop.h"
+#include "qemu/module.h"
+#include "qemu/option.h"
+#include "qemu/timer.h"
+#include "qemu/atomic.h"
+#include "qemu/error-report.h"
+#include "sysemu/sysemu.h"
+#include "chardev/char.h"
+#include "exec/memory.h"
+#include "hw/irq.h"
+#include "hw/core/cpu.h"
+#include "sysemu/cpu-timers.h"
+#include "sysemu/cupc8-lockstep.h"
+
+#define TYPE_CHARDEV_CUPC8 "chardev-cupc8"
+#define SLOT_LEN 512
+
+typedef struct {
+    Chardev parent;
+    int fd_in, fd_out;
+} CharCupc8;
+
+DECLARE_INSTANCE_CHECKER(CharCupc8, CHARDEV_CUPC8, TYPE_CHARDEV_CUPC8)
+
+static struct {
+    MemoryRegion iomem;
+    qemu_irq irq;
+    uint8_t tx[SLOT_LEN];      /* staged by the guest */
+    uint8_t live[SLOT_LEN];    /* what the next frame shifts out */
+    uint8_t rx[SLOT_LEN];
+    uint32_t rxlen, intr;
+    bool armed;                /* committed since the last frame ended */
+} slot;
+
+static struct {
+    CharCupc8 *chr;            /* NULL: no lockstep */
+    QEMUTimer *timer;          /* at the next stop */
+    int64_t grant;
+    char pending;              /* 'S' or 'F' waiting for the clock to reach at */
+    int64_t at;
+    uint8_t frame[SLOT_LEN];
+    uint32_t framelen;
+    bool net_tx;               /* the guest sent a packet: let the host answer */
+    uint64_t net_rx;           /* packets given to the guest (atomic) */
+    int64_t settle_us, settle_max_us;
+} ls;
+
+/* ------------------------------------------------------------ the slot device */
+
+static uint64_t slot_read(void *opaque, hwaddr addr, unsigned size)
+{
+    uint64_t v = 0;
+    if (addr < 0x400) {
+        const uint8_t *buf = addr < 0x200 ? slot.tx : slot.rx;
+        for (unsigned i = 0; i < size; i++) {
+            v |= (uint64_t)buf[(addr & 0x1ff) + i] << (8 * i);
+        }
+        return v;
+    }
+    switch (addr) {
+    case 0x404:
+        return slot.rxlen;
+    case 0x408:
+        return slot.intr;
+    case 0x40c:
+        return 0x4c533843;     /* "C8SL" */
+    }
+    return 0;
+}
+
+static void slot_write(void *opaque, hwaddr addr, uint64_t v, unsigned size)
+{
+    if (addr < 0x200) {
+        for (unsigned i = 0; i < size; i++) {
+            slot.tx[addr + i] = v >> (8 * i);
+        }
+    } else if (addr == 0x400) {
+        uint32_t n = MIN(v, SLOT_LEN);
+        memcpy(slot.live, slot.tx, n);
+        memset(slot.live + n, 0, SLOT_LEN - n);
+        slot.armed = true;
+    } else if (addr == 0x408) {
+        slot.intr &= ~v;
+        qemu_set_irq(slot.irq, slot.intr != 0);
+    }
+}
+
+static const MemoryRegionOps slot_ops = {
+    .read = slot_read,
+    .write = slot_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+void cupc8_slot_init(MemoryRegion *sys_mem, hwaddr base, qemu_irq irq)
+{
+    memory_region_init_io(&slot.iomem, NULL, &slot_ops, NULL, "cupc8-slot", 0x1000);
+    memory_region_add_subregion_overlap(sys_mem, base, &slot.iomem, 1);
+    slot.irq = irq;
+}
+
+static void slot_frame(const uint8_t *b, uint32_t n)
+{
+    memcpy(slot.rx, b, n);
+    slot.rxlen = n;
+    slot.intr |= (slot.intr & 1) ? 2 : 1;
+    slot.armed = false;
+    qemu_set_irq(slot.irq, 1);
+}
+
+/* ------------------------------------------------------------ lockstep */
+
+static int64_t now_ns(void)
+{
+    return qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+}
+
+/* the guest time at which the vCPU must stop next */
+static int64_t stop_time(void)
+{
+    return ls.pending ? ls.at : ls.grant;
+}
+
+bool cupc8_lockstep_due(void)
+{
+    if (!ls.chr) {
+        return false;
+    }
+    return ls.net_tx || now_ns() >= stop_time();
+}
+
+static void read_full(void *buf, size_t n)
+{
+    uint8_t *p = buf;
+    while (n) {
+        ssize_t r = read(ls.chr->fd_in, p, n);
+        if (r < 0 && errno == EINTR) {
+            continue;
+        }
+        if (r <= 0) {
+            exit(0);           /* the emulator has gone */
+        }
+        p += r;
+        n -= r;
+    }
+}
+
+static void write_full(const void *buf, size_t n)
+{
+    const uint8_t *p = buf;
+    while (n) {
+        ssize_t r = write(ls.chr->fd_out, p, n);
+        if (r < 0 && errno == EINTR) {
+            continue;
+        }
+        if (r <= 0) {
+            exit(0);
+        }
+        p += r;
+        n -= r;
+    }
+}
+
+/* one command from the emulator; the BQL is dropped while waiting for it */
+static void read_command(void)
+{
+    uint8_t kind;
+    int64_t t;
+    bql_unlock();
+    read_full(&kind, 1);
+    read_full(&t, 8);
+    if (kind == 'F') {
+        uint16_t n;
+        read_full(&n, 2);
+        uint8_t skip[256];
+        ls.framelen = MIN(n, SLOT_LEN);
+        read_full(ls.frame, ls.framelen);
+        for (uint32_t left = n - ls.framelen; left;) {   /* the DMA takes 512 */
+            uint32_t k = MIN(left, sizeof skip);
+            read_full(skip, k);
+            left -= k;
+        }
+    } else if (kind != 'G' && kind != 'S') {
+        fprintf(stderr, "cupc8 lockstep: unknown command %02x\n", kind);
+        exit(1);
+    }
+    bql_lock();
+    if (kind != 'G') {
+        ls.pending = kind;
+        ls.at = t;
+    }
+    ls.grant = MAX(ls.grant, t);
+}
+
+/* the guest sent a packet: wait until the host has had its say */
+static void net_settle(void)
+{
+    uint64_t seen = qatomic_read(&ls.net_rx);
+    int64_t start = g_get_monotonic_time(), last = start;
+    bql_unlock();
+    /* the packet may have opened a host socket (a TCP connect): the main
+     * loop polls it only once it has gone round, so wake it now */
+    qemu_notify_event();
+    for (;;) {
+        g_usleep(500);
+        int64_t t = g_get_monotonic_time();
+        uint64_t rx = qatomic_read(&ls.net_rx);
+        if (rx != seen) {
+            seen = rx;
+            last = t;
+        }
+        if (t - last >= ls.settle_us || t - start >= ls.settle_max_us) {
+            break;
+        }
+    }
+    bql_lock();
+}
+
+static void stop_timer_cb(void *opaque)
+{
+    /* a halted vCPU waits in rr_wait_io_event until due() */
+    qemu_cpu_kick(first_cpu);
+}
+
+void cupc8_lockstep_sync(void)
+{
+    if (!ls.chr) {
+        return;
+    }
+    for (;;) {
+        int64_t now = now_ns();
+        if (ls.net_tx) {
+            ls.net_tx = false;
+            net_settle();
+            continue;
+        }
+        if (ls.pending && now >= ls.at) {
+            if (ls.pending == 'S') {
+                uint8_t h[10];
+                h[0] = 'R';
+                memcpy(h + 1, &now, 8);  /* x86-64 and aarch64 hosts: little-endian */
+                h[9] = slot.armed;
+                write_full(h, sizeof h);
+                write_full(slot.live, SLOT_LEN);
+            } else {
+                slot_frame(ls.frame, ls.framelen);
+            }
+            ls.pending = 0;
+            continue;
+        }
+        if (ls.pending || now < ls.grant) {
+            break;
+        }
+        read_command();
+    }
+    if (!ls.timer) {
+        ls.timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, stop_timer_cb, NULL);
+    }
+    /* only when it moves: arming a virtual timer kicks the vCPU out of its loop */
+    if (timer_expire_time_ns(ls.timer) != stop_time()) {
+        timer_mod_ns(ls.timer, stop_time());
+    }
+}
+
+void cupc8_lockstep_net_tx(void)
+{
+    if (ls.chr) {
+        ls.net_tx = true;
+        if (current_cpu) {
+            cpu_exit(current_cpu);
+        }
+    }
+}
+
+void cupc8_lockstep_net_rx(void)
+{
+    if (ls.chr) {
+        qatomic_inc(&ls.net_rx);
+    }
+}
+
+/* ------------------------------------------------------------ the chardev */
+
+static int64_t env_ms(const char *name, int64_t def)
+{
+    const char *v = getenv(name);
+    return (v && *v ? atoll(v) : def) * 1000;
+}
+
+/* chardevs are made before -icount is applied: check once the machine is up */
+static void check_icount(Notifier *n, void *data)
+{
+    if (!icount_enabled()) {
+        error_report("chardev: cupc8 needs -icount shift=N,sleep=off");
+        exit(1);
+    }
+}
+static Notifier icount_check = { .notify = check_icount };
+
+static void cupc8_chr_open(Chardev *chr, ChardevBackend *backend,
+                           bool *be_opened, Error **errp)
+{
+    CharCupc8 *c = CHARDEV_CUPC8(chr);
+    const char *path = backend->u.pipe.data->device;
+    g_autofree char *in = g_strdup_printf("%s.in", path);
+    g_autofree char *out = g_strdup_printf("%s.out", path);
+
+    if (ls.chr) {
+        error_setg(errp, "chardev: cupc8: only one");
+        return;
+    }
+    /* O_RDWR: a FIFO opens without waiting for the other end (as char-pipe) */
+    c->fd_in = qemu_open(in, O_RDWR, errp);
+    if (c->fd_in < 0) {
+        return;
+    }
+    c->fd_out = qemu_open(out, O_RDWR, errp);
+    if (c->fd_out < 0) {
+        close(c->fd_in);
+        return;
+    }
+    ls.settle_us = env_ms("CUPC8_LOCKSTEP_SETTLE_MS", 20);
+    ls.settle_max_us = env_ms("CUPC8_LOCKSTEP_SETTLE_MAX_MS", 2000);
+    ls.chr = c;
+    qemu_add_machine_init_done_notifier(&icount_check);
+    *be_opened = true;
+}
+
+static void cupc8_chr_parse(QemuOpts *opts, ChardevBackend *backend,
+                            Error **errp)
+{
+    const char *path = qemu_opt_get(opts, "path");
+    ChardevHostdev *dev;
+
+    if (path == NULL) {
+        error_setg(errp, "chardev: cupc8: no path given");
+        return;
+    }
+    backend->type = CHARDEV_BACKEND_KIND_PIPE;
+    dev = backend->u.pipe.data = g_new0(ChardevHostdev, 1);
+    qemu_chr_parse_common(opts, qapi_ChardevHostdev_base(dev));
+    dev->device = g_strdup(path);
+}
+
+static void char_cupc8_class_init(ObjectClass *oc, void *data)
+{
+    ChardevClass *cc = CHARDEV_CLASS(oc);
+
+    cc->parse = cupc8_chr_parse;
+    cc->open = cupc8_chr_open;
+}
+
+static const TypeInfo char_cupc8_type_info = {
+    .name = TYPE_CHARDEV_CUPC8,
+    .parent = TYPE_CHARDEV,
+    .instance_size = sizeof(CharCupc8),
+    .class_init = char_cupc8_class_init,
+};
+
+static void register_types(void)
+{
+    type_register_static(&char_cupc8_type_info);
+}
+
+type_init(register_types);
