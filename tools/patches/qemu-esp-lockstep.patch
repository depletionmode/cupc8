diff --git i/include/sysemu/cupc8-lockstep.h w/include/sysemu/cupc8-lockstep.h
new file mode 100644
index 0000000..2fde4ca
--- /dev/null
+++ w/include/sysemu/cupc8-lockstep.h
@@ -0,0 +1,18 @@
+/*
+ * CUPC/8 lockstep (system/cupc8-lockstep.c): the Wi-Fi card's QEMU runs in
+ * step with the CUPC/8 whole-machine emulator. Hooks called by the TCG
+ * round-robin loop, the icount warp and user networking; each does nothing
+ * unless a `-chardev cupc8` exists.
+ */
+#ifndef SYSEMU_CUPC8_LOCKSTEP_H
+#define SYSEMU_CUPC8_LOCKSTEP_H
+
+/* the vCPU loop's top, BQL held: talk to the emulator until the guest may run */
+void cupc8_lockstep_sync(void);
+/* true while the guest must not run (nor its clock warp) until sync() */
+bool cupc8_lockstep_due(void);
+/* user networking: the guest sent a packet (tx) or was given one (rx) */
+void cupc8_lockstep_net_tx(void);
+void cupc8_lockstep_net_rx(void);
+
+#endif
