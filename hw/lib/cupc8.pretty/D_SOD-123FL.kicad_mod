(footprint "D_SOD-123FL"
	(version 20240108)
	(generator "cupc8")
	(layer "F.Cu")
	(descr "SOD-123FL (2.7 x 1.8 mm body), pads where JLC's own footprint for it has them (EasyEDA SOD-123FL_L2.7-W1.8-LS3.8-RD: +-1.63 mm); KiCad's D_SOD-123F has them at +-1.4. Pad 1 cathode.")
	(tags "SOD-123FL diode")
	(attr smd)
	(property "Reference" "REF**"
		(at 0 -2 0)
		(layer "F.SilkS")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "Value" "D_SOD-123FL"
		(at 0 2 0)
		(layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_line (start -2.55 -1.15) (end 1.2 -1.15) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(fp_line (start -2.55 1.15) (end 1.2 1.15) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(fp_line (start -2.55 -1.15) (end -2.55 1.15) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(fp_rect (start -1.35 -0.9) (end 1.35 0.9) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
	(fp_line (start -0.9 -0.9) (end -0.9 0.9) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_rect (start -2.8 -1.4) (end 2.8 1.4) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
	(pad "1" smd roundrect (at -1.63 0) (size 1.1 1.1) (layers "F.Cu" "F.Mask" "F.Paste") (roundrect_rratio 0.2))
	(pad "2" smd roundrect (at 1.63 0) (size 1.1 1.1) (layers "F.Cu" "F.Mask" "F.Paste") (roundrect_rratio 0.2))
	(model "${KICAD10_3DMODEL_DIR}/Diode_SMD.3dshapes/D_SOD-123F.step"
		(offset (xyz 0 0 0))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 0))
	)
